{
  "version": 2,
  "regions": ["fra1"],
  "builds": [
    {
      "src": "zing-frontend/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/keep-alive",
      "schedule": "0 10 * * *"
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/dashboard(/.*)?", "dest": "/api/index.py" },
    { "src": "/static/images/(.*)", "dest": "/api/index.py" }
  ]
}
